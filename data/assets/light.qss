QWidget {
    font-family: "Segoe UI", "Arial", sans-serif;
}

QMenuBar::item {
    background: transparent;
    padding: 4px 10px;
}

QLineEdit, QTextEdit, QPlainTextEdit {
    padding: 4px;
    border-radius: 3px;
}

QPushButton {
    border: 1px solid #8f8f91;
    border-radius: 4px;
    background-color: #f0f0f0;
    padding: 5px 4px; 
    min-height: 20px;
}

QPushButton:hover {
    background-color: #e0e0e0;
}
QPushButton:pressed {
    background-color: #d0d0d0;
}

QComboBox {
    padding: 4px;
    padding-right: 20px;
    border: 1px solid #8f8f91;
    border-radius: 3px;
}